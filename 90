#include <stdio.h>

int main()
{
    // declaracao de variaveis
    double S = 0.0;
    double numerador;
    int i;

    // processamento
    for (i = 1; i <= 37; i++)
    {
        numerador = (38 - i) * (39 - i);
        S = S + numerador / i;
    }

    // saida
    printf("O valor da soma S e: %.2f\n", S);

    return 0;
}
