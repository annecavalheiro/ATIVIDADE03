#include <stdio.h>

int main()
{
    // declaracao de variaveis
    double S = 0.0;
    int i;

    // processamento
    for (i = 1; i <= 10; i++)
    {
        if (i % 2 != 0)
            S = S + (double)1 / i;
        else
            S = S - (double)1 / i;
    }

    // saida
    printf("O valor de S e: %.2f\n", S);

    return 0;
}
