#include <stdio.h>
#include <math.h>

int main()
{
    // declaracao de variaveis
    double S = 0.0;
    double numerador = 63.0;
    double fatorial = 1.0;
    double termo;
    int n = 1;

    // processamento
    do
    {
        if (n > 1)
            fatorial = fatorial * n;

        termo = numerador / fatorial;

        if (fabs(termo) >= 0.0000001)
        {
            S = S + termo;
            numerador = numerador - 2.0;
            n++;
        }

    } while (fabs(termo) >= 0.0000001);

    // saida
    printf("O valor da serie S e: %.8f\n", S);
    printf("Quantidade de termos usados: %d\n", n - 1);

    return 0;
}
