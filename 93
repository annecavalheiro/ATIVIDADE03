#include <stdio.h>
#include <math.h>

int main()
{
    // declaracao de variaveis
    double A = 0.0;
    double senA;

    // saida inicial
    printf("Angulo (rad) | Seno (Mac-Laurin)\n");
    printf("--------------------------------\n");

    // repeticao
    while (A <= 6.301)
    {
        // calculo do seno
        senA = A - (pow(A, 3) / 6.0)
                 + (pow(A, 5) / 120.0)
                 - (pow(A, 7) / 5040.0);

        // saida
        printf("%12.1f | %16.4f\n", A, senA);

        A = A + 0.1;
    }

    return 0;
}
